---
layout: layouts/base.njk
title: Interactive Map - Girton Feast
bodyClass: map-fullscreen-page
permalink: /map.html
hideFooter: true
hideBreadcrumbs: true
eleventyNavigation:
  key: Interactive Map
  parent: Home
---

<div class="map-fullscreen-wrapper" x-data="mapController()">
    <!-- Mode Switcher Toggle -->
    <div class="map-mode-switcher">
        <a class="map-home-btn" href="{{ '/' | url }}" aria-label="Return to the Girton Feast home page">
            Home
        </a>
        <button class="map-mode-btn" :class="{ 'active': mode === 'event' }" @click="setMode('event')">
            Event Map
        </button>
        <button class="map-mode-btn" :class="{ 'active': mode === 'transport' }" @click="setMode('transport')">
            Getting Here
        </button>
    </div>

    <!-- Event Map Mode -->
    <div id="map-event" class="map-instance" x-show="mode === 'event'" x-transition:enter="fadeIn" style="z-index: 10;"></div>

    <!-- Getting Here Mode -->
    <div id="map-transport" class="map-instance" x-show="mode === 'transport'" x-transition:enter="fadeIn" style="z-index: 5;"></div>

    <!-- Transport Overlays (Only visible in transport mode) -->
    <div class="transport-overlay" x-show="mode === 'transport'" x-transition:enter="fadeInUp">
        <!-- By Car -->
        <div class="transport-card-wrapper" :class="{ 'is-expanded': expandedTransportCard === 'car' }">
            <div class="transport-card">
                <button class="transport-card-toggle" type="button" @click="toggleTransportCard('car')" :aria-expanded="expandedTransportCard === 'car'" :aria-label="expandedTransportCard === 'car' ? 'Close car travel details' : 'Show car travel details'">
                    <i class="fas" :class="expandedTransportCard === 'car' ? 'fa-times' : 'fa-car'" aria-hidden="true"></i><span class="visually-hidden">Car details</span>
                </button>
                <h5>By Car</h5>
                <p>Limited parking at Rec car park (Accessible only). Other vehicles use the field behind the Rec.</p>
                <a href="https://maps.app.goo.gl/SpqWztHDsx1rBLwk6" target="_blank" rel="noopener noreferrer" class="btn btn-sm rounded-pill">Open Maps</a>
            </div>
        </div>

        <!-- By Bus -->
        <div class="transport-card-wrapper" :class="{ 'is-expanded': expandedTransportCard === 'bus' }">
            <div class="transport-card">
                <button class="transport-card-toggle" type="button" @click="toggleTransportCard('bus')" :aria-expanded="expandedTransportCard === 'bus'" :aria-label="expandedTransportCard === 'bus' ? 'Close bus travel details' : 'Show bus travel details'">
                    <i class="fas" :class="expandedTransportCard === 'bus' ? 'fa-times' : 'fa-bus'" aria-hidden="true"></i><span class="visually-hidden">Bus details</span>
                </button>
                <h5>By Bus</h5>
                <p>Citi 6 stops right outside. Easy access from Cambridge or Oakington.</p>
                <a href="https://www.stagecoachbus.com/routes/east/6/cambridge-oakington/XEAO006.O" target="_blank" rel="noopener noreferrer" class="btn btn-sm rounded-pill">Timetable</a>
            </div>
        </div>

        <!-- By Bike -->
        <div class="transport-card-wrapper" :class="{ 'is-expanded': expandedTransportCard === 'bike' }">
            <div class="transport-card">
                <button class="transport-card-toggle" type="button" @click="toggleTransportCard('bike')" :aria-expanded="expandedTransportCard === 'bike'" :aria-label="expandedTransportCard === 'bike' ? 'Close bike travel details' : 'Show bike travel details'">
                    <i class="fas" :class="expandedTransportCard === 'bike' ? 'fa-times' : 'fa-bicycle'" aria-hidden="true"></i><span class="visually-hidden">Bike details</span>
                </button>
                <h5>By Bike</h5>
                <p>Plenty of cycle parking available at the main entrance.</p>
            </div>
        </div>

        <!-- By Taxi -->
        <div class="transport-card-wrapper" :class="{ 'is-expanded': expandedTransportCard === 'taxi' }">
            <div class="transport-card">
                <button class="transport-card-toggle" type="button" @click="toggleTransportCard('taxi')" :aria-expanded="expandedTransportCard === 'taxi'" :aria-label="expandedTransportCard === 'taxi' ? 'Close taxi travel details' : 'Show taxi travel details'">
                    <i class="fas" :class="expandedTransportCard === 'taxi' ? 'fa-times' : 'fa-taxi'" aria-hidden="true"></i><span class="visually-hidden">Taxi details</span>
                </button>
                <h5>By Taxi</h5>
                <p>Book a ride with our sponsors, <strong>Veezu</strong>, for a reliable trip home.</p>
                <a href="https://www.veezu.co.uk/" target="_blank" rel="noopener noreferrer" class="btn btn-sm rounded-pill">Book with Veezu →</a>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    function mapController() {
        return {
            mode: 'event', // Default mode
            expandedTransportCard: null,
            eventMap: null,
            transportMap: null,

            init() {
                // Initialize both maps on load
                this.initEventMap();
                this.initTransportMap();

                // Leaflet needs a visible, sized element before it can lay out tiles.
                requestAnimationFrame(() => requestAnimationFrame(() => {
                    this.eventMap?.invalidateSize();
                    if (this.mode === 'transport') this.transportMap?.invalidateSize();
                }));

                // Handle initial mode from URL
                const params = new URLSearchParams(window.location.search);
                if (params.get('mode') === 'transport' || params.get('mode') === 'getting-here') {
                    this.setMode('transport');
                }
            },

            setMode(newMode) {
                this.mode = newMode;
                // Invalidate size to ensure markers/tiles render correctly after display change
                // We use $nextTick or a short timeout to ensure Alpine has updated the display property
                setTimeout(() => {
                    if (this.mode === 'event' && this.eventMap) {
                        this.eventMap.invalidateSize();
                    }
                    if (this.mode === 'transport' && this.transportMap) {
                        this.transportMap.invalidateSize();
                    }
                }, 100);
            },

            toggleTransportCard(card) {
                this.expandedTransportCard = this.expandedTransportCard === card ? null : card;
            },

            initEventMap() {
                const mapWidth = 2415;
                const mapHeight = 1759;
                this.eventMap = L.map('map-event', {
                    crs: L.CRS.Simple,
                    minZoom: 0,
                    maxZoom: 4
                });

                const bounds = L.latLngBounds([[0, 0], [mapHeight, mapWidth]]);
                L.imageOverlay('{{ "/images/map/isometric-map-labelled.png" | url }}', bounds).addTo(this.eventMap);
                this.eventMap.setView([mapHeight / 2, mapWidth / 2], 1);
                this.eventMap.setMaxBounds(bounds.pad(0.1));

                // Add event markers - auto-generated from stalls with mapCoords set
                const points = [
                    {% for stall in stalls %}
                    {% if stall.mapCoords %}
                    {
                        name: {{ stall.name | dump | safe }},
                        coords: {{ stall.mapCoords | dump | safe }},
                        info: {{ (stall.description or "") | dump | safe }},
                        tags: {{ (stall.tags or []) | dump | safe }}
                    },
                    {% endif %}
                    {% endfor %}
                ];

                const tagConfig = {
                    'food': { icon: 'fa-utensils', color: '#ff6b6b' },
                    'drink': { icon: 'fa-beer', color: '#4ecdc4' },
                    'community': { icon: 'fa-users', color: '#45b7d1' },
                    'charity': { icon: 'fa-hand-holding-heart', color: '#f7b733' },
                    'games': { icon: 'fa-gamepad', color: '#9d50bb' },
                    'rides': { icon: 'fa-car-side', color: '#f9a826' },
                    'commercial': { icon: 'fa-store', color: '#fc4a1a' },
                    'sweet things': { icon: 'fa-candy-cane', color: '#ff9ff3' },
                    'music': { icon: 'fa-music', color: '#54a0ff' },
                    'stalls': { icon: 'fa-store', color: '#fc4a1a' },
                    'default': { icon: 'fa-map-marker-alt', color: '#333' }
                };

                points.forEach(point => {
                    let config = tagConfig.default;
                    if (point.tags && point.tags.length > 0) {
                        const matchingTag = point.tags.find(t => tagConfig[t.toLowerCase()]);
                        if (matchingTag) {
                            config = tagConfig[matchingTag.toLowerCase()];
                        } else {
                            config = tagConfig.commercial;
                        }
                    }

                    const customIcon = L.divIcon({
                        className: 'custom-leaflet-marker-wrapper',
                        html: `<div class="custom-map-marker" style="background-color: ${config.color}; width: 100%; height: 100%;">
                                 <i class="fas ${config.icon}"></i>
                               </div>`,
                        iconSize: [32, 32],
                        iconAnchor: [16, 16]
                    });

                    L.marker(point.coords, {icon: customIcon}).addTo(this.eventMap)
                        .bindPopup(`<b>${point.name}</b><br>${point.info}`);
                });
            },

            initTransportMap() {
                const mapCoords = [52.2405, 0.0855]; // Girton Recreation Ground
                this.transportMap = L.map('map-transport').setView(mapCoords, 15);

                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19
                }).addTo(this.transportMap);

                L.marker(mapCoords).addTo(this.transportMap)
                    .bindPopup('<b>Girton Feast</b><br>Girton Recreation Ground').openPopup();
            }
        }
    }
</script>
