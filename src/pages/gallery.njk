---
layout: layouts/base.njk
title: Photo Gallery - Girton Feast
permalink: /pages/gallery.html
eleventyNavigation:
  key: Photo Gallery
  order: 5
  icon: fas fa-images
---

{% block extra_head %}
<!-- Fancybox CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />
{% endblock %}

<div class="gallery-page">
    <div class="gallery-page-inner">
        <div class="gallery-heading">
            <h1 class="big-text">Relive the memories</h1>
        </div>

        <div class="gallery-layout">
            <!-- Sticky Navigation Column -->
            <div class="gallery-sidebar">
                <div class="gallery-nav-container">
                    <h2 class="gallery-label">Select Year</h2>

                    <!-- Desktop Nav -->
                    <nav id="gallery-nav" class="gallery-year-nav">
                        <ul id="gallery-nav-ul" class="gallery-year-list">
                            <!-- Year links will be dynamically inserted here -->
                        </ul>
                    </nav>

                    <!-- Mobile Dropdown -->
                    <div class="d-lg-none">
                        <div class="dropdown">
                            <button class="button btn w-100 dropdown-toggle" type="button" id="galleryDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                Select a Year
                            </button>
                            <ul id="gallery-dropdown-ul" class="dropdown-menu w-100 border-thick shadow" aria-labelledby="galleryDropdown">
                                <!-- Mobile year links will be inserted here -->
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gallery Content Column -->
            <div id="gallery-container-wrapper" class="gallery-content">
                <div id="gallery-container">
                    <!-- Loading State -->
                    <p class="gallery-empty">Loading photos…</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% block extra_scripts %}
<!-- JSZip library for creating zip files -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<!-- Fancybox JS -->
<script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
<script>
    // --- START: Gallery Configuration ---
    const photoConfig = [
        {% for item in gallery %}
        { year: {{ item.year }}, images: {{ item.images | dump | safe }}, videos: {{ item.videos | dump | safe }} },
        {% endfor %}
    ];
    // --- END: Gallery Configuration ---

    let currentYear = photoConfig[0]?.year ?? null;

    function buildNavigation() {
        const desktopNav = document.getElementById('gallery-nav-ul');
        const mobileNav = document.getElementById('gallery-dropdown-ul');
        const mobileBtn = document.getElementById('galleryDropdown');

        let desktopHtml = '';
        let mobileHtml = '';

        photoConfig.sort((a,b) => b.year - a.year).forEach(config => {
            const activeClass = config.year === currentYear ? 'active' : '';
            desktopHtml += `
                <li class="nav-item">
                    <a class="nav-link ${activeClass}"
                       href="javascript:void(0)" onclick="switchYear(${config.year})">${config.year}</a>
                </li>
            `;
            mobileHtml += `
                <li><a class="dropdown-item ${activeClass}" href="javascript:void(0)" onclick="switchYear(${config.year})">${config.year}</a></li>
            `;
        });

        desktopNav.innerHTML = desktopHtml;
        mobileNav.innerHTML = mobileHtml;
        mobileBtn.textContent = `Year: ${currentYear}`;
    }

    function switchYear(year) {
        if (year === currentYear) return;
        currentYear = year;
        buildNavigation();
        renderGallery();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderGallery() {
        const container = document.getElementById('gallery-container');
        const config = photoConfig.find(c => c.year === currentYear);
        if (!config) {
            container.innerHTML = '<p class="gallery-empty">Photos will be added soon.</p>';
            return;
        }

        let html = `
            <div class="fadeIn">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
                    <h2 class="big-text gallery-year-heading">${config.year} Collection</h2>
                    <button class="button btn gallery-download" onclick="downloadYearAsZip(${config.year}, this)">
                        <i class="fas fa-download me-2"></i>Download Photos
                    </button>
                </div>
                <div class="gallery-grid">
        `;

        const prefix = window.siteConfig?.pathPrefix || '/';
        const cleanPrefix = prefix.endsWith('/') ? prefix : prefix + '/';

        config.images.forEach((imageFilename, index) => {
            const i = index + 1;
            const imagePath = `${cleanPrefix}images/previous/${config.year}/${imageFilename}`;

            // Random rotation between -3 and 3 degrees
            const rotation = (Math.random() * 6 - 3).toFixed(2);
            const delay = (i % 20) * 40; // Stagger first 20 images

            html += `
                <a href="${imagePath}"
                   data-fancybox="gallery-${config.year}"
                   data-caption="Girton Feast ${config.year} - Photo ${i}"
                   class="gallery-photo"
                   style="transform: rotate(${rotation}deg); animation-delay: ${delay}ms;">
                    <img src="${imagePath}" alt="Photo ${i}" loading="lazy" onload="this.classList.add('loaded')">
                </a>
            `;
        });

        config.videos.forEach((videoFilename, index) => {
            const videoNumber = config.images.length + index + 1;
            const videoPath = `${cleanPrefix}images/previous/${config.year}/${videoFilename}`;
            const extension = videoFilename.split('.').pop().toLowerCase();
            const mimeType = extension === 'mov' ? 'video/quicktime' : `video/${extension === 'ogv' ? 'ogg' : extension}`;

            html += `
                <figure class="gallery-photo gallery-video-card">
                    <video controls preload="none" playsinline aria-label="Girton Feast ${config.year} video ${videoNumber}">
                        <source src="${videoPath}" type="${mimeType}">
                        Your browser cannot play this video. <a href="${videoPath}" download>Download ${videoFilename}</a>.
                    </video>
                </figure>
            `;
        });
        html += `</div></div>`;
        container.innerHTML = html;

        // Re-bind Fancybox
        Fancybox.bind("[data-fancybox]", {});
    }

    async function downloadYearAsZip(year, button) {
        const config = photoConfig.find(c => c.year === year);
        if (!config) return;

        const originalText = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Zipping...';

        const zip = new JSZip();
        const imagePromises = [];

        config.images.forEach((imageFilename) => {
            const prefix = window.siteConfig?.pathPrefix || '/';
            const imageUrl = `${prefix}images/previous/${year}/${imageFilename}`;
            const promise = fetch(imageUrl)
                .then(response => {
                    if (!response.ok) throw new Error(`Image ${imageFilename} not found`);
                    return response.blob();
                })
                .then(blob => {
                    zip.file(imageFilename, blob);
                })
                .catch(error => console.error(`Failed to fetch ${imageUrl}:`, error));
            imagePromises.push(promise);
        });

        await Promise.all(imagePromises);

        zip.generateAsync({ type: "blob" })
            .then(function (content) {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(content);
                link.download = `girton-feast-${year}-photos.zip`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                button.disabled = false;
                button.innerHTML = originalText;
            });
    }

    document.addEventListener('DOMContentLoaded', () => {
        buildNavigation();
        renderGallery();
    });
</script>
{% endblock %}
