{% set sponsorRotations = ["rotate-left-sm", "rotate-right-xs", "rotate-left-xs", "rotate-right-sm", "rotate-right-xs", "rotate-left-xs"] %}

<!-- Sponsors section -->
<section id="sponsors" class="sponsors-section py-5 my-5 overflow-hidden">
    <h2 class="big-text text-center">Thank you<br>for your<br>support</h2>

    <div id="sponsors-marquee" class="splide sponsor-marquee" aria-labelledby="sponsors-heading">
        <div class="splide__track">
            <ul class="splide__list">
                {% for sponsor in sponsors %}
                    {% set rotation = sponsorRotations[loop.index0 % 6] %}
                    <li class="splide__slide">
                        <div class="sponsor-logo-wrapper {{ rotation }}">
                            {% if sponsor.url %}
                                <a href="{{ sponsor.url }}" target="_blank" rel="noopener noreferrer">
                                    <img src="{{ ('/images/sponsors/' + sponsor.image) | url }}" alt="Logo of an official event sponsor." class="sponsor-logo-img" loading="lazy" decoding="async">
                                </a>
                            {% else %}
                                <img src="{{ ('/images/sponsors/' + sponsor.image) | url }}" alt="Logo of an official event sponsor." class="sponsor-logo-img" loading="lazy" decoding="async">
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    <a href="{{ '/pages/contact.html' | url }}" class="button btn">Become a sponsor</a>
    <!-- <button id="sponsor-marquee-toggle" class="button btn sponsor-marquee-toggle" type="button" aria-controls="sponsors-marquee" aria-pressed="true" hidden>Pause scrolling</button> --!>
</section>
