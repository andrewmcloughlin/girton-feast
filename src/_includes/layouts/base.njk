<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Girton Feast" }}</title>

    <!-- Bootstrap CSS from CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Preload the LCP image -->
    <link rel="preload" fetchpriority="high" as="image" href="{% imageUrl "/images/hero.png" %}" type="image/webp">
    <link rel="preload" href="{{ '/images/map-lg.svg' | url }}" as="image" type="image/svg+xml">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sigmar+One&family=Poller+One&family=Spicy+Rice&family=Glass+Antiqua&family=Annie+Use+Your+Telescope&family=Comfortaa:wght@300..700&family=DynaPuff:wght@400..700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    {% block extra_head %}{% endblock %}

    <!-- Custom CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <!-- Custom Stylesheet -->
    <link rel="stylesheet" href="{{ "/css/style.css" | url }}">

    <!-- Alpine.js -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{ '/images/favicons/apple-touch-icon.png' | url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicons/favicon-32x32.png' | url }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ '/images/favicons/favicon-16x16.png' | url }}">
    <link rel="shortcut icon" href="{{ '/images/favicons/favicon.ico' | url }}">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P2D103WGWN"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-P2D103WGWN');

        window.siteConfig = {
            pathPrefix: "{{ '/' | url }}".replace(/\/+$/, '') + '/',
            eventInfo: {{ event_info | dump | safe }}
        };

        // Ensure pathPrefix works correctly in local dev
        if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
            if (!window.location.pathname.startsWith(window.siteConfig.pathPrefix)) {
                console.warn('Path prefix mismatch detected. Adjusting siteConfig.pathPrefix for local development.');
                window.siteConfig.pathPrefix = '/';
            }
        }
    </script>
</head>
<body tabindex="0" class="bg-secondary">

    <main>
        {{ content | safe }}
    </main>


    <!-- Bootstrap JS Bundle from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js"></script>
    <script src="{{ '/js/script.js' | url }}"></script>

</body>
</html>
