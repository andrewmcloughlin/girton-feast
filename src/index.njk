<section id="thank-you-hero" class="container-fluid bg-brand-glaucous content-container pb-5 px-3">
    <div class="text-center pt-5 mb-4 animate-on-scroll">
        <h1 class="display-1 fw-bold mb-3">
            <img src="{{ '/images/girton-feast-logo-text.svg' | url }}" alt="Girton Feast Logo" class="img-fluid hero-logo"
                style="max-height: 250px;">
        </h1>
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 max-width-container mx-auto"
             style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); max-width: 900px; border: 3px solid #000 !important; box-shadow: 8px 8px 0 0 rgba(0, 0, 0, 1) !important;">

            <h2 class="display-4 fw-bold mb-4 font-dynapuff text-brand-purple">
                Thank you for joining us!
            </h2>

            <p class="lead fs-3 font-comfortaa text-dark mb-4">
                Girton Feast will return in 2027 on <span class="text-brand-giants-orange fw-bold">9th and 10th July</span>.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 mb-5">
                <a href="{{ '/pages/gallery.html' | url }}" class="sticker-button sticker-button-pink px-4 py-3 fs-5 font-dynapuff text-decoration-none">
                    <i class="fas fa-images me-2"></i>Photo Gallery
                </a>
            </div>

            <!-- YouTube Video Embed -->
            <div class="ratio ratio-16x9 rounded-4 overflow-hidden border-thick shadow" style="border: 3px solid #000; box-shadow: 4px 4px 0 0 rgba(0, 0, 0, 1) !important;">
                <iframe width="1840" height="1035" src="https://www.youtube.com/embed/M5oyebP1RhA" title="Girton Feast 2026, Cambridge" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</section>

